rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedMediaType() {
      return request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'image/avif'
        || request.resource.contentType == 'image/bmp'
        || request.resource.contentType == 'image/gif'
        || request.resource.contentType == 'image/heic'
        || request.resource.contentType == 'image/heif'
        || request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/tiff'
        || request.resource.contentType == 'image/webp'
        || request.resource.contentType == 'video/3gpp'
        || request.resource.contentType == 'video/3gpp2'
        || request.resource.contentType == 'video/mp4'
        || request.resource.contentType == 'video/mpeg'
        || request.resource.contentType == 'video/quicktime'
        || request.resource.contentType == 'video/webm'
        || request.resource.contentType == 'video/x-m4v'
        || request.resource.contentType == 'video/x-msvideo';
    }

    function hasSafeClientMetadata() {
      return !('firebaseStorageDownloadTokens' in request.resource.metadata);
    }

    function isValidSession(session) {
      return session.matches('^(submit-story_)?[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}_[a-z0-9]{12}$');
    }

    function isSubmissionJson(fileName) {
      return fileName == '_submission.json'
        && request.resource.contentType == 'application/json'
        && request.resource.size <= 100 * 1024
        && hasSafeClientMetadata();
    }

    function isTipMedia(fileName) {
      return fileName.matches('^(0[1-9]|10)_[A-Za-z0-9_.() -]{1,160}$')
        && request.resource.size > 0
        && request.resource.size <= 500 * 1024 * 1024
        && isAllowedMediaType()
        && hasSafeClientMetadata();
    }

    // Anonymous tipline uploads are write-only. Nobody can list, read,
    // overwrite, or delete objects through the public client SDK.
    match /tips/{session}/{fileName} {
      allow create: if isValidSession(session)
        && (isTipMedia(fileName) || isSubmissionJson(fileName));
      allow read, update, delete: if false;
    }

    // Everything else in the bucket is locked down.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
